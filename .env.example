# Copia a .env y ajusta valores reales (no subas .env al repositorio).

PORT=8767
CORS_ALLOW_ORIGINS=*

TRAEFIK_HOST=agente-voz.laliga.org.co
TLS_PORT=8768
APP_PUBLIC_HTTPS_URL=https://seguimiento.laliga.org.co:8768
PUBLIC_HTTPS_HOST=seguimiento.laliga.org.co

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=30m

GROUNDED_ONLY=true
OUT_OF_SCOPE_REPLY=Solo puedo informarte con los datos que tengo cargados: Plan Liga, especialidades médicas y contacto para citas.
GREETING_REPLY=Hola, soy el asistente de La Liga Ama Salvar Vidas. Puedo contarte sobre el Plan Liga, especialidades o contacto de citas.
IN_SCOPE_HELP_REPLY=Puedo informarte sobre Plan Liga, especialidades médicas y contacto institucional.

TTS_VOICE=es-CO-SalomeNeural
TTS_RATE=+15%
TTS_VOICE_MAX_CHARS=3200

WELCOME_MESSAGE=Hola, bienvenido al chat asistencial de la liga ama salvar vidas. Para iniciar tu petición, primero escribe la cédula y el nombre.

# auto = Google español primero (rápido), Whisper local si falla | google | whisper
STT_ENGINE=auto
STT_LANGUAGE=es-CO
STT_FALLBACK_GOOGLE=false
STT_FALLBACK_ON_LOW_CONFIDENCE=false

WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=es
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=false
WHISPER_FAST_FFMPEG=true
WHISPER_CPU_THREADS=0
WHISPER_INITIAL_PROMPT=Español colombiano. La Liga Ama Salvar Vidas. Plan Liga, membresía, citas médicas.

STT_POLISH_WITH_LLM=false
PLAN_LIGA_USE_LLM=false
GROUNDED_ANSWER_WITH_LLM=true
GROUNDED_ANSWER_TEMPERATURE=0.15
ROUTING_USE_LLM=true
CHAT_TEXT_FIRST=true
# false = voz usa el mismo LLM anclado al catálogo que el chat (recomendado)
VOICE_FAST_ANSWER=false
VOICE_ROUTING_USE_LLM=false
VOICE_TTS_MAX_CHARS=1400
VOICE_STREAM_LLM=true
VOICE_GROUNDED_NUM_PREDICT=380
STT_POLISH_TEMPERATURE=0.15
STT_POLISH_NUM_CTX=2048
STT_POLISH_PROMPT=Corriges transcripciones de reconocimiento de voz en español colombiano. El usuario habla con un asistente de La Liga Ama Salvar Vidas sobre Plan Liga, membresía, familiares o beneficiarios, precios, requisitos, citas médicas, especialidades. Arregla errores fonéticos sin inventar datos. Mantén la intención y palabras clave. Una sola frase clara. Devuelve SOLO el texto corregido, sin comillas ni explicación.
